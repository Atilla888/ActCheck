# Copy to .env and enter credentials locally. Never commit .env.
# These are configuration inputs for the future clients, not a working integration.
# See docs/MODEL_ACCESS.md for verified access instructions and outstanding checks.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL=sam-3.1
META_SPARK_MODEL=muse-spark-1.3

BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open

# Optional fallback: gated SAM weights. Access must be approved separately.
HF_TOKEN=
SAM_WEIGHTS_REPO=facebook/sam3.1

# Local paths may contain private source images and model outputs; ignored by Git.
ACTCHECK_PRIVATE_DIR=data/private
ACTCHECK_CACHE_DIR=data/cache
ACTCHECK_OUTPUT_DIR=outputs

# Planning targets only; enforcement and usage tracking are not implemented yet.
ACTCHECK_DAILY_BUDGET_USD=10
ACTCHECK_JUDGING_RESERVE_USD=50
